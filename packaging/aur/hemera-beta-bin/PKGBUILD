# Maintainer: Kristen Jestin <kristen.jestin@pm.me>
#
# The latest beta of Hemera, the pre-release built from every push to `dev`. It installs beside
# `hemera-bin` under its own name: /opt/hemera-beta, /usr/bin/hemera-beta and its own icon.
pkgname=hemera-beta-bin
_app=hemera-beta
_product='Hemera Beta'
_asset=Hemera.Beta
_version=0.1.1-26-g8394bab
pkgver=0.1.1.r26.g8394bab
pkgrel=1
pkgdesc='Desktop cockpit for ACP agents (beta)'
arch=('x86_64')
url='https://github.com/KristenJestin/hemera'
license=('LicenseRef-UNLICENSED')
# What the Electron binary links against, as namcap finds it, and what it loads at run time:
# libsecret for the cookie encryption key, xdg-utils to open a link in the browser.
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'glib2' 'glibc' 'gtk3'
  'hicolor-icon-theme' 'libcups' 'libgcc' 'libsecret' 'libx11' 'libxcb' 'libxcomposite'
  'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon' 'libxrandr' 'mesa' 'nspr' 'nss' 'pango'
  'systemd-libs' 'xdg-utils')
provides=("$_app")
conflicts=("$_app")
options=('!strip' '!debug')
source=("$_app-$_version.deb::$url/releases/download/beta-$_version/$_asset-$_version.deb")
sha256sums=('b82a33d4d421deae0c6e6ce492947619796872ca20fc61e0d00ff833f32b84a7')

package() {
  bsdtar -xf data.tar.xz -C "$srcdir"

  install -d "$pkgdir/opt"
  cp -a "$srcdir/opt/$_product" "$pkgdir/opt/$_app"
  # The Chromium sandbox helper runs setuid where user namespaces are off (linux-hardened).
  chmod 4755 "$pkgdir/opt/$_app/chrome-sandbox"

  install -d "$pkgdir/usr/bin"
  ln -s "/opt/$_app/$_app" "$pkgdir/usr/bin/$_app"

  install -Dm644 "$srcdir/usr/share/applications/$_app.desktop" \
    "$pkgdir/usr/share/applications/$_app.desktop"
  sed -i "s|^Exec=.*|Exec=/usr/bin/$_app %U|" "$pkgdir/usr/share/applications/$_app.desktop"

  install -d "$pkgdir/usr/share/icons"
  cp -a "$srcdir/usr/share/icons/hicolor" "$pkgdir/usr/share/icons/hicolor"

  install -Dm644 "$pkgdir/opt/$_app/LICENSES.chromium.html" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSES.chromium.html"
}
